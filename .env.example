# Public build configuration. These values are included in the static site.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
CONTACT_API_URL=
TURNSTILE_SITE_KEY=

# Server-only Supabase Edge Function configuration. Never use these in frontend builds.
OWNER_USER_ID=YOUR_OWNER_AUTH_USER_UUID
ALLOWED_ORIGINS=https://dkhilifares.github.io
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SUPABASE_SECRET_KEY
TURNSTILE_SECRET_KEY=

# Optional message alert delivery.
RESEND_API_KEY=
NOTIFY_TO=
NOTIFY_FROM=
OWNER_PORTAL_URL=https://dkhilifares.github.io/manage/

# GitHub App publishing is not implemented. Do not configure production secrets until it is.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_REPOSITORY_OWNER=
GITHUB_REPOSITORY_NAME=
GITHUB_DEFAULT_BRANCH=main
